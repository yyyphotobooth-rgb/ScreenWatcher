<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- App version: the only place it is set. Window title shows Major.Minor ("ScreenWatcher 1.0");
         the journal/log build id uses the full informational version. -->
    <Version>1.3.1</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Physical pixels everywhere, so window/client coordinates match captured pixels. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Lower idle RAM for a small always-on tray app. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <!-- Normal build: the files sit next to the exe (the tests load the same files). Publish
       (publish.ps1): not copied, the single exe reads the embedded copies below (AppFiles.cs). -->
  <ItemGroup>
    <None Update="detectors.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Update="glyphs.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Update="icons.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Update="docs\discord-bot-guide.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <EmbeddedResource Include="detectors.json" LogicalName="ScreenWatcher.Files.detectors.json" />
    <EmbeddedResource Include="glyphs.json" LogicalName="ScreenWatcher.Files.glyphs.json" />
    <EmbeddedResource Include="icons.json" LogicalName="ScreenWatcher.Files.icons.json" />
    <EmbeddedResource Include="docs\discord-bot-guide.html" LogicalName="ScreenWatcher.Files.discord-bot-guide.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net.WebSocket" Version="3.20.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI controls (internal) are built in tests: a main-window row that throws while it is built
         stops the app from starting (1.3.0). -->
    <InternalsVisibleTo Include="ScreenWatcher.Tests" />
  </ItemGroup>

</Project>
