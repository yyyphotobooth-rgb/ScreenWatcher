    "missNoteMaxChars": 500,
    // Collection mode "อัตโนมัติ": collect a region only while one of these rules is true for it,
    // plus the ring from preSeconds before it starts and postSeconds after it ends.
    "auto": {
      "preSeconds": 10,
      "postSeconds": 10,
      "fuelBelowPercent": 30,        // a. fuel reading below this
      "scaleAtLeast": 1.2,           // b. HUD scale (x or y) at or above this: all regions
      "killAtLeast": 290,            // c. kill counter at or above this
      "itemMargin": 2,               // d. item/potion count <= its threshold + this
      "ammoBelow": 50,               // e. gun or missile counter below this
                                     // f. every alert: preSeconds before to postSeconds after
      "unknownSeconds": 5,           // g. a row shows "?" longer than this while the HUD is present
      "itemJump": 50,                // h. a stable item count rises by more than this,
      "ammoJump": 1000,              //    a stable ammo count rises by more than this,
                                     //    or the stable kill counter goes down
      "jumpStablePolls": 2,          //    "stable" = the same reading on this many polls in a row
                                     // g. also: when a row crosses the "อ่านค่าไม่ได้" limit, the
                                     //    full client frame once then, and once more this many
                                     //    seconds later if the row is still unreadable
      "unreadableFullFrameRepeatSeconds": 30
    }
  }
}
