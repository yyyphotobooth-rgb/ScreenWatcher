    "emptyFrameMinShare": 0.9, "emptyMaxChannel": 70, "emptyMinBlueOverRed": 4, "emptyNavyMinShare": 0.9,
    "items": [
      { "id": "ammoBox", "name": "กล่องเติมกระสุน", "unit": "กล่อง", "defaultThreshold": 5, "icons": [ "ammoBox" ],
        "lowMessage": "{0}เหลือ {1} {2} เตรียมเติมเสบียง", "goneMessage": "{0}หมดคลัง!" },
      { "id": "fuelBottles", "name": "ขวดน้ำมัน", "unit": "ขวด", "defaultThreshold": 2, "icons": [ "bottle" ], "maxDistance": 13,
        "lowMessage": "เชื้อเพลิงสำรองเหลือ {1} {2}", "goneMessage": "เชื้อเพลิงสำรองหมด!" },
      { "id": "monsterCard", "name": "บัตรกันมอน", "unit": "ใบ", "defaultThreshold": 3, "icons": [ "card" ],
