    // Row "เลเวลอัพ" (Detection/Hud/LevelDetector.cs): the line "Lv.88 50.61%" at the bottom centre,
    // on the exp bar under the item bar (text rows H-12..H-6 at 1.0). Light grey (222,222,222) with
    // a black outline, in the game's own 4x7 pixel font (no Windows font renders it). Left-aligned:
    // "Lv." (12 px), the level digits from +13 px at a 5 px pitch, then a space. Digits measured on
    // the lossless frames (live*_printwindow, from-chat, collect 2026-11-18, the trial's PNGs:
    // levels 85 and 88, percentages); "2" only on the trial's JPEG frames (36.52 %, 51.21 %, 17.22 %).
    // At ~1.3 no sample shows the line whole (alive_2560x1440 cuts it): cells are sampled at the
    // HUD scale, tested on a synthetic stretch only.
    "message": "เลื่อนเลเวล! Lv.{0} → Lv.{1}",
    "stablePolls": 3,
    "maxStep": 2,
    // Quest panel message suppressed this long after a level-up alert.
