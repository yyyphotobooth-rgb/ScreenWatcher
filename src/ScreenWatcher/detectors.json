// ScreenWatcher detector settings. All pixel coordinates are in physical pixels,
// relative to the game window's CLIENT area top-left (title bar and borders excluded).
// Measured from samples/ (1024x768 dead samples and 1600x1024 live captures); see samples/README.md.
{
  "pollIntervalMs": 1000,

  "window": {
    "titlePrefix": "ACE Online",
    // The small disconnect error dialog is titled "ACEonline"; never treat it as the game.
    "excludeTitles": [ "ACEonline" ]
  },

  "drop": {
    // The game window was seen earlier and is now missing for this many consecutive checks.
    "missingChecksToFire": 2,
    "message": "เกมส์หลุด"
  },

  "alerts": {
    // Discord alert sent on death: ONE image holding these collect regions (below) side by side,
    // cut from the frame the death was seen on. Game dropped is text only.
    "deathCropRegions": [ "gauge", "dialog" ],
    // A failed send is retried after each of these delays, then logged and dropped.
    "retryDelaysSeconds": [ 2, 5, 15, 30 ],
    // Alerts waiting to be sent; more are dropped (and logged).
    "queueLimit": 8
  },

  "hudScale": {
    // The game scales its whole HUD about the client top-left (1.0 up to 1080 px client height,
    // larger above). The scale is MEASURED, not computed from the resolution: the gauge's outer
    // ring is searched for and its size gives the scale (X and Y separately; the OS can squeeze a
    // window taller than the screen). Every gauge/dialog coordinate below is the 1.0 layout and is
    // multiplied by the measured scale. Ring at 1.0 (samples/live_printwindow.png): left edge
    // x~7.9, right ~156.1, top ~30.7, bottom ~178.2, i.e. outer diameter ~148 px; band ~7.7 px.
    "ringCenter": [ 82.0, 104.45 ],
    "ringOuterRadius": 74.0,
    "ringInnerRadius": 66.3,
    // Colour is compared this many screen pixels either side of each ring boundary.
    "edgeProbePx": 1.5,
    "angles": 120,
    "minScale": 0.8,
    "maxScale": 2.2,
    "coarseStep": 0.01,
    "refineRange": 0.03,
    "refineStep": 0.0025,
    // Ring "found" when the mean edge strength reaches minScore and the peak stands out from the
    // average over all candidate scales by minPeakToMean. Samples: ring present 203..383
    // (peak/mean 4.1..6.4); no gauge at the top-left <= 72 (HudScaleTests).
    "minScore": 120,
    "minPeakToMean": 2.5,
    // While the ring is not found at the current size, retry every N polls (keep last good scale).
    "retryEveryPolls": 5
  },

  "death": {
    "message": "ตายแล้ว",
    // Gauge dark AND dialog present continuously for at least this long.
    "holdSeconds": 1.5,

    "gauge": {
      // 1.0 layout (multiplied by the measured hudScale; patch size scales too). Gauge centre
      // (82,104); outer ring diameter ~148 px (used by hudScale). HP band (left, red) and right band (blue) form an annulus r = 40..64.
      // Patches are centred on r = 52 at 30/60/120/150 degrees from vertical, avoiding the
      // number text at 90 degrees and the centre fuel disc.
      "patchSize": 6,
      "leftPatches": [ [ 56, 59 ], [ 37, 78 ], [ 37, 130 ], [ 56, 149 ] ],
      "rightPatches": [ [ 108, 59 ], [ 127, 78 ], [ 127, 130 ], [ 108, 149 ] ],
      // "Red" (HP filled): mean R >= redMinR and G,B each <= R * redMaxOtherRatio.  Alive ~ (150,2,2).
      "redMinR": 110,
      "redMaxOtherRatio": 0.3,
      // "Dark" (empty): max channel <= darkMaxChannel.  Dead ~ left (56,9,4), right (72,28,12);
      // alive right half is blue ~ (13,143,211), so it is never "dark".
      "darkMaxChannel": 110,
      // HP counts as "back" (re-arm) when at least this many left patches are red.
      "minHpFilledPatches": 1
    },

    "dialog": {
      // 1.0 layout: offsets and patch size are multiplied by the measured hudScale; the box stays
      // centred on the client. Dark navy "return to town?" box, 376x95 px at 1.0, spans x -189..+186 and y -44..+50 from the
      // client centre (W/2, H/2). Patches sit in the plain body, away from text and buttons.
      "patchWidth": 16,
      "patchHeight": 6,
      "patchOffsetsFromCenter": [ [ -169, -31 ], [ 156, -31 ], [ -169, 14 ], [ 156, 14 ], [ -104, 29 ], [ 96, 29 ] ],
      // Body is opaque, measured (3..4, 19..37, 34..70) in both dead samples. The game's own
      // "INFORMATION" window uses a similar navy but measured (11..18, 40..60, 66..97), so R is
      // the key separator (sample live3_printwindow.png).
      "navyMaxR": 8,
      "navyMinB": 25,
      "navyMaxB": 90,
      "navyMinBMinusR": 20,
      "minMatchingPatches": 6
    }
  },

  "collect": {
    // "Collect data" mode (off by default; the user's choice is kept in
    // %LOCALAPPDATA%\ScreenWatcher\settings.json). Files go to %LOCALAPPDATA%\ScreenWatcher\collect.
    // When the folder grows past this size, this mode's oldest files are deleted first.
    "maxMegabytes": 200,
    // Per region: at most one save every N seconds, and a heartbeat save every N seconds.
    "minSecondsBetweenSaves": 2,
    "heartbeatSeconds": 60,
    // Full client frame this often (plus on every death / game-dropped event).
    "fullFrameMinutes": 5,
    // Pending writes; when the writer falls behind, new saves are skipped (never block polling).
    "queueLimit": 24,

    // Change test (Collection/HudSignature.cs). Each region lists the HUD's own colours ("keys",
    // RGB boxes measured from samples and from live collected crops). Each poll every pixel gets
    // the index of the key it matches (or none); the region changed when at least
    // minChangedPixels (at 1.0, scaled by area) differ from the last SAVED crop, at the best
    // alignment within +-maxShift px. The scene seen through the semi-transparent panels rarely
    // falls inside these narrow boxes. Tested on sample pairs and on 64 live kill-counter crops
    // over sky, rock, grass, lava (CollectChangeTests).
    "change": {
      "maxShift": 1,
      "minChangedPixels": 8
    },

    // Regions, measured on samples/ at 1.0 (1024x768 .. 1920x1080 clients) and checked at ~1.31
    // where the sample shows them (see samples/README.md "Collect regions").
    "regions": [
      // HP/shield gauge + orange fuel arc + "xxx/300" fuel text and pump icon. Ring x 8..156,
      // y 30..178; fuel text x ~146..181, y ~73..82; pump icon to x ~172. Quest panel starts ~x 180.
      {
        "name": "gauge", "anchor": "topLeft", "rect": [ 0, 24, 192, 164 ],
        "keys": [
          { "name": "hp red", "min": [ 120, 0, 0 ], "max": [ 220, 20, 20 ] },          // (150..170,0..8,0..8)
          { "name": "blue fill", "min": [ 0, 95, 160 ], "max": [ 45, 130, 215 ] },     // (0..40,100..120,170..195)
          { "name": "fuel orange", "min": [ 200, 85, 0 ], "max": [ 235, 120, 12 ] },  // arc + pump (215..223,96..108,0)
          { "name": "yellow", "min": [ 190, 125, 0 ], "max": [ 220, 165, 12 ] },      // centre semicircle (200..211,134..153,0)
          { "name": "text", "min": [ 215, 215, 215 ], "max": [ 229, 229, 229 ], "outlineMax": 20 } // exactly (222,222,222) on (0,0,0)
        ]
      },
      // Two 5-digit counters: machine gun digits x ~60..123, missile x ~182..248, y ~12..25;
      // reload bars y ~2..8. Buff icons start at x ~258; gauge ring at y 30.
      {
        "name": "ammo", "anchor": "topLeft", "rect": [ 0, 0, 256, 30 ],
        "keys": [
          // Digit core (207,236,254). The digits' blue outline (3..15,96..102,172..175) is NOT used:
          // the panel tint over some skies lands on the same blue.
          { "name": "digit core", "min": [ 195, 225, 245 ], "max": [ 215, 245, 255 ] },
          { "name": "reload bar", "min": [ 245, 50, 0 ], "max": [ 255, 115, 20 ] },     // (255,58..105,6..11)
          { "name": "empty red", "min": [ 215, 10, 15 ], "max": [ 250, 55, 55 ] },      // missile_empty (225..244,22..42,26..44)
          { "name": "empty pink", "min": [ 250, 160, 160 ], "max": [ 255, 225, 225 ] }  // its digit core
        ]
      },
      // Orange kill counter + wing emblem, right edge. Digits right-aligned ending at W-75,
      // 3 digits from W-129 (each extra digit ~18 px further left), y 335..349; panel y ~330..356.
      // Seen only at 1.0 (1024x768 and 1600x1024 clients). Map grid panel above ends at y ~326.
      {
        "name": "kill", "anchor": "topRight", "rect": [ -180, 326, 180, 40 ],
        "keys": [
          // Fill (255,83,15) with same-hue edges (~(209..254,68..83,12..15)) in 64 live crops.
          // Lava in a dead sample measured (230..233,107..110,55..59): kept out by G and B.
          { "name": "digits", "min": [ 200, 60, 5 ], "max": [ 255, 92, 25 ] }
        ]
      },
      // Skill/item bar incl. count digits and page arrow: frame x c-168..c+160 (arrow to c+170),
      // y H-53..H-14; status text above the bar at ~H-66. "Lv / exp %" text below (H-12..H-2)
      // is left out on purpose (it changes with every exp gain).
      {
        "name": "items", "anchor": "bottomCenter", "rect": [ -190, -74, 380, 62 ],
        "keys": [
          // Counts are exactly (255,255,255) with a (0,0,0) outline. Bright sky above the bar
          // measured (255,221..234,187..203), so the box is kept tight and neutral.
          { "name": "count", "min": [ 250, 250, 250 ], "max": [ 255, 255, 255 ], "outlineMax": 20 }
        ]
      },
      // Centre dialog area. Death dialog is x -189..+186, y -44..+50 from the centre.
      {
        "name": "dialog", "anchor": "center", "rect": [ -240, -110, 480, 220 ],
        // A dialog is big (death dialog: ~11k key px live at 1024x768). Floating name labels and
        // the ship hull near the centre hit the same (222,222,222) as dialog text (live noise up
        // to ~740 changed px), so this region needs a much larger change than the others.
        "minChangedPixels": 1000,
        "keys": [
          // Body (3..4,19..37,34..70). Dark river water has the same colour but is textured, so
          // the body must be flat over +-2 px horizontally.
          { "name": "death dialog body", "min": [ 0, 15, 30 ], "max": [ 8, 45, 75 ], "flatRadius": 2, "flatTolerance": 2 },
          { "name": "text", "min": [ 215, 215, 215 ], "max": [ 229, 229, 229 ], "outlineMax": 75 } // exactly (222,222,222)
        ]
      }
    ]
  }
}
