<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ScreenWatcher\ScreenWatcher.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests use the app's real config so tuned thresholds are what gets tested. -->
    <None Include="..\..\src\ScreenWatcher\detectors.json" Link="detectors.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ScreenWatcher\glyphs.json" Link="glyphs.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ScreenWatcher\icons.json" Link="icons.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
