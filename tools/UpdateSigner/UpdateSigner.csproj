<Project Sdk="Microsoft.NET.Sdk">
  <!-- Release tool for publish.ps1: signs dist\ScreenWatcher.exe with the private key kept OUTSIDE
       the repo (C:\ScreenWatcher-keys) and checks the result with the public key built into the app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ScreenWatcher\ScreenWatcher.csproj" />
  </ItemGroup>
</Project>
